.me-card { display: flex; align-items: center; gap: 24rpx; padding: 28rpx; }
.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--sun);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #5B4A00;
}
.me-name { font-size: 34rpx; font-weight: 800; }

.stats-bar {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 999rpx;
  background: #E8F7EE;
  color: #1E6B3C;
  font-weight: 700;
  text-align: center;
}

.badge-wall { display: flex; flex-wrap: wrap; gap: 16rpx; }
.badge-cell {
  width: 150rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.06);
}
.badge-cell.milestone { border: 3rpx dashed #D9C46A; }
.badge-cell.milestone.unlocked { border: 4rpx solid #E8A800; }
.badge-cell.unlocked { background: #FFF7D6; box-shadow: 0 4rpx 0 #E8C547; }
.badge-icon { font-size: 44rpx; opacity: 0.35; }
.badge-cell.unlocked .badge-icon { opacity: 1; }
.badge-name { font-size: 22rpx; margin-top: 8rpx; color: #9AA3AD; font-weight: 600; }
.badge-cell.unlocked .badge-name { color: #8A6D00; }
.wall-empty { text-align: center; color: var(--muted); }

.pf-row { padding: 10rpx 0; border-bottom: 2rpx dashed #EDF2F7; }
.pf-row:last-child { border-bottom: none; }
.profile-empty { text-align: center; color: var(--muted); padding: 40rpx 0; }

.logout-btn { margin: 56rpx 0 40rpx; }

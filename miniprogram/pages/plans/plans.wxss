.hero { padding: 32rpx 28rpx; margin-bottom: 8rpx; }
.hero-title { font-size: 42rpx; font-weight: 800; }
.hero-sub { margin-top: 6rpx; }

.safety-banner {
  background: var(--safety-bg);
  border: 4rpx dashed var(--coral);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin: 24rpx 0 8rpx;
}
.safety-title { font-weight: 800; margin-bottom: 8rpx; }
.safety-item { font-size: 26rpx; padding: 4rpx 0; }

.archived-label { border-left-color: #A0AEC0; }

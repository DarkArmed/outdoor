/* ===== 设计 token（纸系卡通风） ===== */
page {
  --paper: #FFFDF5;
  --card: #FFFFFF;
  --ink: #2D3748;
  --muted: #718096;
  --sky: #7ED6FF;
  --sky-deep: #4FC3F7;
  --sun: #FFD93D;
  --grass: #7CDB6E;
  --grass-dk: #4CAF50;
  --coral: #FF6B6B;
  --orange: #FFA94D;
  --purple: #A78BFA;
  --pink: #FF8FAB;
  --safety-bg: #FFF5F5;

  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 30rpx;
  line-height: 1.65;
}

/* ===== 公共类 ===== */
.page-body { padding: 24rpx; }
.card { background: var(--card); border-radius: 24rpx; box-shadow: 0 6rpx 18rpx rgba(45, 55, 72, 0.08); }
.pad { padding: 20rpx 24rpx; }
.muted { color: var(--muted); font-size: 26rpx; }
.empty { text-align: center; padding: 80rpx 40rpx; color: var(--muted); }

.month-label {
  font-size: 34rpx;
  font-weight: 800;
  margin: 32rpx 0 16rpx;
  padding-left: 14rpx;
  border-left: 10rpx solid var(--sun);
  border-radius: 4rpx;
}

/* 主按钮 */
.btn-primary {
  background: var(--sky-deep);
  color: #fff;
  font-weight: 700;
  font-size: 32rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
  box-shadow: 0 6rpx 0 rgba(79, 195, 247, 0.35);
}
.btn-primary::after { border: none; }
.btn-sun {
  background: var(--sun);
  color: #5B4A00;
  font-weight: 800;
  font-size: 32rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
  box-shadow: 0 6rpx 0 rgba(232, 197, 71, 0.6);
}
.btn-sun::after { border: none; }
.btn-ghost {
  background: #EDF2F7;
  color: var(--muted);
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.btn-ghost::after { border: none; }

/* 徽章（配色与网站一致） */
.badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #EDF2F7;
  color: #4A5568;
  margin: 0 10rpx 10rpx 0;
}
.badge.type-A { background: #B2F5EA; color: #234E52; }
.badge.type-B { background: #C6F6D5; color: #22543D; }
.badge.type-C { background: #FEEBC8; color: #7B341E; }
.badge.type-D { background: #E9D8FD; color: #44337A; }
.badge.type-E { background: #CDEBFF; color: #1D4E7E; }
.badge.badge-mom { background: #FFD9E4; color: #B03060; }
.badge.badge-drive { background: #EBF8FF; color: #2C7A7B; }

/* 主题场景底色（emoji 大图区浅色渐变） */
.theme-water { background: linear-gradient(135deg, #E0F7FF, #B2F5EA); }
.theme-hike { background: linear-gradient(135deg, #F0FFF4, #C6F6D5); }
.theme-camp,
.theme-campnight { background: linear-gradient(135deg, #FFF7E0, #FEEBC8); }
.theme-cycle { background: linear-gradient(135deg, #EBF8FF, #CDEBFF); }
.theme-grassland { background: linear-gradient(135deg, #F0FFF4, #FEEBC8); }
.theme-snow,
.theme-winter { background: linear-gradient(135deg, #EBF8FF, #E9D8FD); }
.theme-default { background: linear-gradient(135deg, #EDF2F7, #E2E8F0); }

/* ===== 详情页公共区块 ===== */
.d-hero { overflow: hidden; text-align: center; padding-bottom: 24rpx; }
.d-art { height: 220rpx; display: flex; align-items: center; justify-content: center; }
.d-emoji { font-size: 120rpx; }
.d-title { font-size: 40rpx; font-weight: 800; margin-top: 8rpx; }
.d-meta { margin-top: 4rpx; font-size: 24rpx; }
.d-badges { margin-top: 12rpx; display: flex; flex-wrap: wrap; justify-content: center; }

.goal-box { background: #FFFBEB; border: 4rpx solid var(--sun); border-radius: 20rpx; padding: 20rpx 24rpx; }
.tip-box { background: #EBF8FF; border: 4rpx solid var(--sky-deep); border-radius: 20rpx; padding: 20rpx 24rpx; }

.day-name { font-weight: 800; margin: 12rpx 0 8rpx; color: var(--orange); }
.it-item { display: flex; gap: 16rpx; padding: 10rpx 0; border-bottom: 2rpx dashed #EDF2F7; }
.it-item:last-child { border-bottom: none; }
.it-time { flex: 0 0 110rpx; font-weight: 700; color: var(--grass-dk); font-size: 26rpx; }
.it-text { flex: 1; }

.gear-group-title { font-weight: 800; margin: 20rpx 0 4rpx; }
.gear-progress { height: 20rpx; border-radius: 999rpx; background: #E2E8F0; overflow: hidden; margin: 8rpx 0; }
.gear-progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--grass), var(--grass-dk));
  transition: width 0.3s;
}
.gear-progress-text { text-align: center; font-size: 26rpx; color: var(--muted); margin-bottom: 8rpx; }
.gear-progress-text.all-done { color: var(--grass-dk); font-weight: 800; }

.safety-row { background: var(--safety-bg); border-radius: 16rpx; padding: 14rpx 20rpx; margin: 12rpx 0; }
.review-box { background: #F0FFF4; border: 4rpx dashed var(--grass-dk); border-radius: 20rpx; padding: 20rpx 24rpx; }

/* 底部固定操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: var(--card);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.bottom-gap { height: 180rpx; }

/* 底部弹层（日期选择等） */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  background: rgba(43, 58, 103, 0.45);
  display: flex;
  align-items: flex-end;
}
.join-panel {
  width: 100%;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.join-title { font-weight: 800; font-size: 32rpx; text-align: center; }
.join-date {
  margin: 24rpx auto;
  text-align: center;
  background: var(--paper);
  border-radius: 16rpx;
  padding: 20rpx;
  font-weight: 700;
}

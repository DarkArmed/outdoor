DATABASE_URL=postgresql://outdoor:outdoor@localhost:5432/outdoor
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 微信小程序登录 AppID/Secret：留空且 DEBUG=true 时走 mock 登录（dev_ 前缀 openid），生产必须配置真实值
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# Container mode: production disables automatic table creation and API docs.
APP_ENV=development
STATIC_DIR=
# Optional secret files: do not set the corresponding plain value at the same time.
# DATABASE_URL_FILE=/run/secrets/database_url
# SECRET_KEY_FILE=/run/secrets/secret_key
